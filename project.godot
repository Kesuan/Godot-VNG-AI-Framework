; Engine configuration file.
; 本工程为框架开发工程：承载测试框架、剧本 DSL 与其自测；不设置主场景。
; 游戏工程在 vng-demo/（由 tools/demo 接入，见 docs/decision/0003）。

config_version=5

[application]

config/name="Godot VNG AI Framework"
config/description="AI Agent 视觉小说开发框架：测试框架 + 剧本 DSL。"
config/features=PackedStringArray("4.7", "GL Compatibility")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
